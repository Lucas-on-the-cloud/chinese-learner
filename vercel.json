{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ],
  "redirects": [
    {
      "source": "/((?!maintenance\\.html|robots\\.txt|favicon\\.ico).*)",
      "has": [{ "type": "host", "value": "tocflfafa.com" }],
      "destination": "/maintenance.html",
      "permanent": false
    },
    {
      "source": "/((?!maintenance\\.html|robots\\.txt|favicon\\.ico).*)",
      "has": [{ "type": "host", "value": "www.tocflfafa.com" }],
      "destination": "/maintenance.html",
      "permanent": false
    }
  ],
  "crons": [
    { "path": "/api/cron/fetch-news", "schedule": "0 6 * * *" }
  ]
}
