    { "source": "/api/:path*", "destination": "/api/:path*" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "chinese-learner-coral.vercel.app" }],
      "destination": "https://tocflfafa.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
